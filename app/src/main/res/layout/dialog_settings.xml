<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textColor="@color/primary_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Configura los datos de acceso a tu módem Telmex."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/modem_ip_label"
        android:textColor="@color/text_main"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etModemIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="192.168.1.254"
        android:inputType="textUri"
        android:text="192.168.1.254" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/modem_user_label"
        android:textColor="@color/text_main"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etModemUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="TELMEX"
        android:inputType="text"
        android:text="TELMEX" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/modem_pass_label"
        android:textColor="@color/text_main"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etModemPass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Clave WPA del módem"
        android:inputType="textPassword" />

</LinearLayout>
